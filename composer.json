{
  "name": "elavora/api-datatypes",
  "description": "Pacote agregador dos DataTypes Elavora API.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "elavora/api-datatype-base64": "^1.0",
    "elavora/api-datatype-cnpj": "^1.0",
    "elavora/api-datatype-cpf": "^1.0",
    "elavora/api-datatype-date-time": "^1.0",
    "elavora/api-datatype-email": "^1.0",
    "elavora/api-datatype-file-name": "^1.0",
    "elavora/api-datatype-file-path": "^1.0",
    "elavora/api-datatype-folder-name": "^1.0",
    "elavora/api-datatype-folder-path": "^1.0",
    "elavora/api-datatype-json": "^1.0",
    "elavora/api-datatype-storage-key": "^1.0",
    "elavora/api-datatype-url": "^1.0",
    "elavora/api-datatype-uuid": "^1.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Elavora\\Api\\DataTypes\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "elavora/code-standards": "^1.1",
    "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
  },
  "scripts": {
    "lint": "elavora-standards lint",
    "test": "phpunit -c phpunit.xml",
    "check": [
      "@lint",
      "@test"
    ],
    "post-install-cmd": ["Elavora\\CodeStandards\\Composer::sync"],
    "post-update-cmd": ["Elavora\\CodeStandards\\Composer::sync"]
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0-dev"
    }
  }
}
