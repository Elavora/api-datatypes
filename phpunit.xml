<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php"
        cacheDirectory=".phpunit.cache"
        colors="true"
        failOnWarning="true">
    <testsuites>
        <testsuite name="datatypes">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>vendor/elavora</directory>
        </include>
        <exclude>
            <directory>vendor/elavora/code-standards</directory>
        </exclude>
    </source>
</phpunit>
